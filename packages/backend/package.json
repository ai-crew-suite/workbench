{
  "name": "@ai-crew-suite/backend",
  "description": "An isolated, non-published local validation sandbox and testpad for testing the workbench backend dev server.",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "agentic workflow",
    "ai-crew-suite",
    "backstage",
    "backstage-backend",
    "testpad",
    "sandbox",
    "integration-testing",
    "code-coverage",
    "hermetic-testing"
  ],
  "backstage": {
    "role": "backend-plugin"
  },
  "bugs": {
    "url": "https://github.com/ai-crew-suite/workbench/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/workbench",
    "directory": "packages/backend"
  },
  "scripts": {
    "format": "crew format",
    "lint": "crew lint",
    "test:e2e": "crew test:e2e",
    "test:unit": "crew test:unit",
    "test:unit:coverage": "crew test:unit:coverage",
    "start": "yarn run -T backstage-cli workbench compose start backend",
    "start:dev": "backstage-dev-server",
    "typecheck": "crew typecheck"
  },
  "dependencies": {
    "@ai-crew-suite/crew-cli": "catalog:dev",
    "@ai-crew-suite/workbench-backend": "workspace:*",
    "@backstage/catalog-model": "backstage:^"
  },
  "devDependencies": {
    "@ai-crew-suite/typescript-shared-config": "catalog:dev"
  }
}
