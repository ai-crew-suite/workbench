{
  "name": "@ai-crew-suite/workbench-app",
  "bundled": true,
  "license": "Apache-2.0",
  "keywords": [
    "agentic workflow",
    "ai-crew-suite",
    "app",
    "backstage"
  ],
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "backstage": {
    "role": "frontend"
  },
  "bin": {
    "backstage-dev-app": "./launcher.js"
  },
  "files": [
    "dist",
    "skeleton",
    "launcher.js"
  ],
  "bugs": {
    "url": "https://github.com/ai-crew-suite/workbench/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/workbench",
    "directory": "packages/app"
  },
  "scripts": {
    "format": "crew format",
    "lint": "crew lint",
    "test:unit": "crew test:unit",
    "typecheck": "crew typecheck"
  },
  "dependencies": {
    "@ai-crew-suite/server-dependencies-app": "workspace:^"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "catalog:dev",
    "@ai-crew-suite/typescript-shared-config": "catalog:dev",
    "@playwright/test": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "jsdom": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
