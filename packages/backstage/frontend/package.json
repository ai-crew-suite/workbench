{
  "name": "@ai-crew-suite/workbench-frontend",
  "bundled": true,
  "license": "Apache-2.0",
  "keywords": [
    "agentic workflow",
    "ai-crew-suite",
    "app",
    "backstage"
  ],
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "backstage": {
    "role": "frontend"
  },
  "bin": {
    "backstage-dev-frontend": "./launcher.js"
  },
  "files": [
    "dist",
    "skeleton",
    "launcher.js"
  ],
  "bugs": {
    "url": "https://github.com/ai-crew-suite/workbench/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/workbench",
    "directory": "packages/frontend"
  },
  "scripts": {
    "format": "crew format",
    "lint": "crew lint",
    "test:unit": "crew test:unit",
    "typecheck": "crew typecheck"
  },
  "dependencies": {
    "@backstage/frontend-defaults": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "@backstage/plugin-api-docs": "backstage:^",
    "@backstage/plugin-app-react": "backstage:^",
    "@backstage/plugin-app-visualizer": "backstage:^",
    "@backstage/plugin-catalog": "backstage:^",
    "@backstage/plugin-catalog-graph": "backstage:^",
    "@backstage/plugin-kubernetes": "backstage:^",
    "@backstage/plugin-notifications": "backstage:^",
    "@backstage/plugin-org": "backstage:^",
    "@backstage/plugin-scaffolder": "backstage:^",
    "@backstage/plugin-search": "backstage:^",
    "@backstage/plugin-search-backend-module-techdocs": "backstage:^",
    "@backstage/plugin-signals": "backstage:^",
    "@backstage/plugin-techdocs": "1.18.2",
    "@backstage/plugin-user-settings": "backstage:^",
    "@backstage/theme": "backstage:^",
    "@backstage/ui": "backstage:^",
    "@material-ui/core": "catalog:prod",
    "@mui/icons-material": "catalog:prod",
    "@mui/material": "catalog:prod",
    "react": "catalog:prod",
    "react-dom": "catalog:prod",
    "react-router": "catalog:prod",
    "react-router-dom": "catalog:prod",
    "yaml": "catalog:prod"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "catalog:dev",
    "@ai-crew-suite/typescript-shared-config": "catalog:dev",
    "@playwright/test": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "jsdom": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
