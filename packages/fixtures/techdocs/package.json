{
  "name": "@ai-crew-suite/fixtures-techdocs",
  "description": "Pre-compiled programmatic TechDocs asset blueprints and search indexes for the AI Crew Suite dev server sandbox.",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "keywords": [
    "agentic workflow",
    "ai-crew-suite",
    "backstage",
    "techdocs",
    "fixtures",
    "documentation",
    "search-index"
  ],
  "main": "dist/index.js",
  "types": "dist/index.js",
  "files": [
    "dist",
    "static-compiled"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/ai-crew-suite/workbench/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/workbench",
    "directory": "packages/fixtures/techdocs"
  },
  "scripts": {
    "build": "turbo run build:ts build:techdocs",
    "build:ts": "tsc -b",
    "build:techdocs": "./scripts/build-techdocs.sh",
    "clean": "rimraf dist static-compiled",
    "format": "backstage-cli crew format",
    "lint": "backstage-cli crew lint",
    "release": "npm publish --access public",
    "test:unit": "backstage-cli crew test:unit",
    "test:unit:coverage": "backstage-cli crew test:unit:coverage",
    "typecheck": "backstage-cli crew typecheck"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@techdocs/cli": "catalog:dev",
    "rimraf": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
