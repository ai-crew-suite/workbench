{
  "extends": ["//"],
  "tasks": {
    "build:ts": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "build:techdocs": {
      "cache": true,
      "inputs": ["markdown/**", "scripts/build-techdocs.sh", "scripts/mkdocs-container.sh"],
      "outputs": ["static-compiled/**"]
    },
    "build": {
      "cache": true,
      "dependsOn": ["build:ts", "build:techdocs"]
    },
    "release": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["dist/**", "package.json", "README.md"]
    }
  }
}
