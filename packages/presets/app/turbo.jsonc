{
  "extends": ["//"],
  "tasks": {
    "format": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "e2e-tests/**",
        "public/**",
        "skeleton/**",
        "src/**",
        "launcher.js",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "release": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": [
        "e2e-tests/**",
        "public/**",
        "skeleton/**",
        "src/**",
        "launcher.js",
        "package.json",
        "tsconfig.json"
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "e2e-tests/**",
        "public/**",
        "skeleton/**",
        "src/**",
        "launcher.js",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "test:unit": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "e2e-tests/**",
        "public/**",
        "skeleton/**",
        "src/**",
        "launcher.js",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "typecheck": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "e2e-tests/**",
        "public/**",
        "skeleton/**",
        "src/**",
        "launcher.js",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": []
    }
  }
}
