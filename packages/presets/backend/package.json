{
  "name": "@ai-crew-suite/presets-backend",
  "description": "A published Backstage backend server for use in Dockerfiles",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "backstage-dev-server": "./launcher.js"
  },
  "engines": {
    "node": "22 || 24"
  },
  "packageManager": "yarn@4.18.0",
  "keywords": [
    "agentic workflow",
    "ai-crew-suite",
    "app",
    "backstage"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "backstage": {
    "role": "backend"
  },
  "bugs": {
    "url": "https://github.com/ai-crew-suite/workbench/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/workbench",
    "directory": "packages/presets/backend"
  },
  "files": [
    "dist",
    "skeleton",
    "src",
    "launcher.js"
  ],
  "scripts": {
    "format": "backstage-cli crew format",
    "lint": "backstage-cli crew lint",
    "release": "npm publish --access public",
    "test:unit": "backstage-cli crew test:unit",
    "test:unit:coverage": "backstage-cli crew test:unit:coverage",
    "typecheck": "backstage-cli crew typecheck"
  },
  "dependencies": {
    "@ai-crew-suite/dependencies-backend": "workspace:^"
  },
  "devDependencies": {
    "@ai-crew-suite/typescript-shared-config": "catalog:dev",
    "@backstage/backend-test-utils": "backstage:^",
    "@backstage/cli": "backstage:^",
    "@backstage/plugin-catalog-node": "backstage:^",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
