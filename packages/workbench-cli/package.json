{
  "name": "@ai-crew-suite/cli-module-workbench",
  "description": "Backstage CLI module for workbench tasks",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "engines": {
    "node": "22 || 24"
  },
  "keywords": [
    "ai-crew-suite",
    "cli",
    "workbench"
  ],
  "packageManager": "yarn@4.18.1",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "cli-module"
  },
  "bugs": {
    "url": "https://github.com/ai-crew-suite/workbench/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/workbench",
    "directory": "packages/workbench-cli"
  },
  "main": "bin/module.cjs",
  "types": "src/index.ts",
  "bin": {
    "backstage-cli-module-workbench": "bin/backstage-cli-module-workbench"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly --outDir ../../dist-types/packages/workbench-cli && backstage-cli package build",
    "clean": "rimraf dist",
    "lint": "crew lint",
    "test:e2e": "crew test:e2e",
    "test:unit": "crew test:unit",
    "test:unit:coverage": "crew test:unit:coverage",
    "typecheck": "crew typecheck"
  },
  "dependencies": {
    "@ai-crew-suite/fixtures-external": "workspace:^",
    "@ai-crew-suite/fixtures-kubernetes": "workspace:^",
    "@backstage/cli-node": "backstage:^",
    "@snyk/docker-registry-v2-client": "catalog:prod",
    "chalk": "catalog:prod",
    "commander": "catalog:prod",
    "dclint": "catalog:prod",
    "dockerode": "catalog:prod",
    "dotenv": "catalog:prod",
    "proper-lockfile": "^4.1.2",
    "tar": "catalog:prod"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "catalog:dev",
    "@ai-crew-suite/typescript-shared-config": "catalog:dev",
    "@backstage/cli": "backstage:^",
    "@types/dockerode": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/proper-lockfile": "^4.1.4",
    "rimraf": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
