{
  "extends": ["//"],
  /** Remove dependsOn for tasks in Crew CLI package */
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["src/**", "package.json", "rollup.config.ts", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    /**
     * No ordering constraints are needed currently: sibling packages' `crew`
     * scripts resolve to the published @ai-crew-suite/crew-cli in node_modules,
     * and no consumer of this package's `workbench` dist bin defines a clean
     * task, so nothing races against `rimraf dist`.
     */
    "clean": {
      "cache": false,
      "dependsOn": []
    },
    "lint": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test:unit": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["src/**"],
      "outputs": []
    },
    "test:unit:coverage": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["src/**"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": []
    }
  }
}
