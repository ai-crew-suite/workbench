{
  "extends": ["//"],
  "tasks": {
    "tf:init": {
      "cache": true,
      "outputs": [".terraform/**", ".terraform.lock.hcl"]
    },
    "tf:validate": {
      "dependsOn": ["tf:init"],
      "cache": true,
      "outputs": []
    },
    "tf:plan": {
      "dependsOn": ["tf:validate"],
      "cache": false,
      "passThroughEnv": [
        "TF_VAR_database_secure_password",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_DEFAULT_REGION"
      ]
    }
  }
}
