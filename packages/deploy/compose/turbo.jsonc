{
  "extends": ["//"],
  "tasks": {
    "check": {
      "cache": false
    },
    "compose:up": {
      "cache": false,
      "persistent": true
    },
    "compose:down": {
      "cache": false
    },
    "compose:logs": {
      "cache": false
    },
    "compose:ps": {
      "cache": false
    }
  }
}
