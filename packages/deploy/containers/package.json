{
  "name": "@ai-crew-suite/containers",
  "description": "CI base harness images, deterministic testing infrastructure stacks, and mock control plane configurations for the AI Crew Suite platform",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "keywords": [
    "agentic workflow",
    "ai-crew-suite",
    "docker",
    "containers"
  ],
  "bugs": {
    "url": "https://github.com/ai-crew-suite/workbench/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/workbench",
    "directory": "packages/deploy/containers"
  },
  "scripts": {
    "build": "yarn turbo run image:build",
    "image:build": "./scripts/build.sh",
    "lint": "yarn turbo run image:lint",
    "image:lint": "./scripts/lint.sh",
    "test": "yarn turbo run image:test:structure image:test:security image:test:unit",
    "image:test:structure": "./scripts/test-structure.sh",
    "image:test:security": "./scripts/scan-security.sh",
    "image:test:unit": "vitest run"
  },
  "devDependencies": {
    "@ai-crew-suite/typescript-shared-config": "catalog:dev",
    "testcontainers": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
