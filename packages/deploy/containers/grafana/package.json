{
  "name": "@ai-crew-suite/grafana-container",
  "description": "Pre-provisioned Grafana v13 visualization hub with embedded infrastructure health dashboards for the AI Crew Suite platform",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "keywords": [
    "grafana",
    "dashboards",
    "metrics-visualization",
    "observability",
    "ai-crew-suite",
    "docker"
  ],
  "bugs": {
    "url": "https://github.com/ai-crew-suite/workbench/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/workbench",
    "directory": "packages/deploy/containers/grafana"
  },
  "scripts": {
    "build": "workbench image:build temporal-container",
    "lint": "workbench image:lint temporal-container",
    "image:test:security": "workbench image:test:security temporal-container",
    "image:test:structure": "workbench image:test:structure temporal-container",
    "publish": "workbench image:publish temporal-container",
    "test": "yarn image:test:security && yarn image:test:structure && yarn test:unit",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@ai-crew-suite/typescript-shared-config": "catalog:dev",
    "@ai-crew-suite/workbench-cli": "workspace:^",
    "vitest": "catalog:dev"
  }
}
