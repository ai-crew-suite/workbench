  "panels": [
    {
      "title": "Memory Consumption Real-time Gauge",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Used Memory",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "min": 0,
          "max": 1073741824,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "title": "Memory Usage vs. System Limits",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Memory In Use",
          "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "redis_memory_max_bytes",
          "legendFormat": "Max Allocated Limit",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "decbytes"
        }
      }
    },
    {
      "title": "Evicted Keys Activity Tracker",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(redis_evicted_keys_total[1m])",
          "legendFormat": "Evictions/sec",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars" },
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      }
    }
