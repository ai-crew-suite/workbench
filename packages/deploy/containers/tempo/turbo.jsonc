{
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "cache": false,
      "dependsOn": [],
      "inputs": [
        "**/Dockerfile",
        "**/src/**/*",
        "**/requirements.txt",
        "scripts/build.sh"
      ],
      "outputs": []
    },
    "image:lint": {
      "cache": true,
      "inputs": [
        "Dockerfile"
      ],
      "outputs": []
    },
    "image:test:structure": {
      "cache": false,
      "dependsOn": [],
      "inputs": [
        "__tests__/**/*.cst.yaml"
      ],
      "outputs": []
    },
    "image:test:security": {
      "cache": false,
      "dependsOn": [],
      "env": [
        "TRIVY_SCAN_TIMEOUT"
      ],
      "outputs": []
    },
    "publish": {
      "cache": false,
      "dependsOn": [],
      "env": [
        "REGISTRY"
      ],
      "outputs": []
    },
    "image:promote": {
      "cache": false,
      "dependsOn": [],
      "env": [
        "REGISTRY"
      ],
      "outputs": []
    }
  }
}
