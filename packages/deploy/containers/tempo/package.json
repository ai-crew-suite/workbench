{
  "name": "@ai-crew-suite/tempo-container",
  "description": "Grafana Tempo distributed tracing backend container for tracking microservice execution span timelines across the AI Crew Suite platform",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "keywords": [
    "grafana-tempo",
    "distributed-tracing",
    "spans",
    "observability",
    "ai-crew-suite",
    "docker"
  ],
  "bugs": {
    "url": "https://github.com/ai-crew-suite/workbench/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/workbench",
    "directory": "packages/deploy/containers/tempo"
  },
  "scripts": {
    "build": "workbench image:build tempo-container",
    "lint": "workbench image:lint tempo-container",
    "image:test:security": "workbench image:test:security tempo-container",
    "image:test:structure": "workbench image:test:structure tempo-container",
    "publish": "workbench image:publish tempo-container",
    "test": "yarn image:test:security && yarn image:test:structure && yarn test:unit",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@ai-crew-suite/typescript-shared-config": "catalog:dev",
    "@ai-crew-suite/workbench-cli": "workspace:^",
    "vitest": "catalog:dev"
  }
