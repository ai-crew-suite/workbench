{
  "extends": ["//"],
  "tasks": {
    "image:build": {
      "dependsOn": ["^build"],
      "inputs": [
        "**/Dockerfile",
        "**/src/**/*",
        "**/requirements.txt",
        "scripts/build.sh"
      ],
      "env": ["REGISTRY", "IMAGE_TAG"],
      "cache": true,
      "outputs": []
    },
    "image:lint": {
      "inputs": [
        "**/Dockerfile",
        "scripts/lint.sh"
      ],
      "cache": true
    },
    "image:test:structure": {
      "dependsOn": ["image:build"],
      "inputs": [
        "**/__tests__/*.cst.yaml",
        "**/Dockerfile",
        "scripts/test-structure.sh"
      ],
      "cache": true
    },
    "image:test:security": {
      "dependsOn": ["image:build"],
      "inputs": [
        "scripts/scan-security.sh"
      ],
      "cache": true
    },
    "image:test:unit": {
      "dependsOn": ["image:build"],
      "inputs": [
        "**/__tests__/*.spec.ts",
        "**/Dockerfile",
        "**/src/**/*",
        "vitest.config.ts"
      ],
      "cache": true
    }
  }
}
