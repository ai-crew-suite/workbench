{
  "extends": ["//"],
  "tasks": {
    "image:build": {
      "dependsOn": ["^build"],
      "inputs": [
        "**/Dockerfile",
        "**/src/**/*",
        "**/requirements.txt",
        "scripts/build-script.sh"
      ],
      "cache": true,
      "outputs": []
    },
    "image:lint": {
      "inputs": ["**/Dockerfile", "scripts/lint-docker.sh"],
      "cache": true
    },
    "test:structure": {
      "dependsOn": ["image:build"],
      "inputs": [
        "**/__tests__/*.yaml",
        "scripts/test-structure.sh"
      ],
      "cache": true
    },
    "image:test:security": {
      "dependsOn": ["image:build"],
      "inputs": ["scripts/scan-security.sh"],
      "cache": true
    },
    "image:test:unit": {
      "dependsOn": ["image:build"],
      "inputs": [
        "**/__tests__/*.spec.ts",
        "**/Dockerfile",
        "**/src/**/*"
      ],
      "cache": true
    }
  }
}
