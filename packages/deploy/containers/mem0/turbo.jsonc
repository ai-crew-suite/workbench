{
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": false,
      "inputs": [
        "**/Dockerfile",
        "**/src/**/*",
        "**/requirements.txt",
        "scripts/build.sh",
        "package.json"
      ],
      "env": ["REGISTRY", "IMAGE_TAG", "CI"],
      "outputs": []
    },
    "image:lint": {
      "cache": true,
      "inputs": ["Dockerfile"],
      "outputs": []
    },
    "image:test:structure": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["__tests__/**/*.cst.yaml", "Dockerfile"],
      "outputs": []
    },
    "image:test:security": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["Dockerfile"],
      "env": ["TRIVY_SCAN_TIMEOUT"],
      "outputs": []
    },
    "test:unit": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "src/**",
        "**/__tests__/**/*.test.ts",
        "**/__tests__/**/*.spec.ts",
        "vitest.config.ts"
      ],
      "outputs": []
    },
    "publish": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["Dockerfile"],
      "env": ["REGISTRY", "IMAGE_TAG"],
      "outputs": []
    }
  }
}
