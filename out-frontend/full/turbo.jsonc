{
  "$schema": "https://turbo.build",
  "globalEnv": [
    "BACKSTAGE_APP_CONFIG",
    "BACKSTAGE_USER_SECRET",
    "CI",
    "NODE_ENV",
    "POSTGRES_PASSWORD",
    "POSTGRES_USER"
  ],
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build",
        "clean"
      ],
      "env": [
        "FORCE_COLOR"
      ],
      "inputs": [
        "src/**",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "clean": {
      "cache": false,
      "dependsOn": []
    },
    "compose:down": {
      "cache": false
    },
    "compose:up": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [],
      "outputs": []
    },
    "helm:lint": {
      "cache": true,
      "outputs": []
    },
    "helm:template": {
      "cache": true,
      "outputs": []
    },
    "image:build": {
      "cache": true,
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "lint": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [],
      "outputs": []
    },
    "sync": {
      "cache": false,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "packages/**/package.json"
      ],
      "outputs": [
        "packages/**/tsconfig.json",
        "tsconfig.json"
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**"
      ]
    },
    "test:unit": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**"
      ],
      "outputs": []
    },
    "test:unit:coverage": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "tf:init": {
      "cache": true,
      "outputs": [
        ".terraform/**",
        ".terraform.lock.hcl"
      ]
    },
    "tf:plan": {
      "cache": false,
      "dependsOn": [
        "tf:validate"
      ],
      "passThroughEnv": [
        "TF_VAR_database_secure_password",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_DEFAULT_REGION"
      ]
    },
    "tf:validate": {
      "cache": true,
      "dependsOn": [
        "tf:init"
      ],
      "outputs": []
    },
    "typecheck": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "//#format:turbo": {
      "cache": false,
      "inputs": [
        "turbo.jsonc",
        "packages/**/turbo.jsonc"
      ],
      "outputs": []
    },
    "//#lint:turbo": {
      "cache": false,
      "inputs": [
        "turbo.jsonc",
        "packages/**/turbo.jsonc"
      ],
      "outputs": []
    }
  }
}