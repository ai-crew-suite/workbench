# ====================================================================================
# 🛡️ GLOBAL DESK CONSTRAINTS & DEVELOPMENT METRICS
# ====================================================================================
CI="false"
NODE_ENV="development"
REGISTRY="localhost:32443/ai-crew-suite"
IMAGE_TAG="latest"

# ====================================================================================
# 🚀 CORE PLATFORM VECTOR KEYS & SECRETS
# ====================================================================================
BACKSTAGE_APP_CONFIG=""
BACKSTAGE_USER_SECRET=""
TF_VAR_database_secure_password=""

# --- Cloud Ingress Targets ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ====================================================================================
# 💾 PERSISTENT PERSISTENCE DATA LAYER OVERRIDES (pgvector / PostgreSQL)
# ====================================================================================
POSTGRES_HOST="postgres-store"
POSTGRES_PORT=5432
POSTGRES_DB="backstage_plugin_catalog"
POSTGRES_USER="backstage"
DB_PASSWORD="backstage_secret_pass"

# ====================================================================================
# 🏎️ TRANSIENT STATE CACHE & SUPPORT BOUNDARIES (Redis)
# ====================================================================================
REDIS_HOST_PORT=6379
REDIS_ADDR="redis-cache:6379"

# ====================================================================================
# 🧠 AI MEMORY LAYER PLATFORM CONFIGURATIONS (Mem0 Engine)
# ====================================================================================
MEM0_PORT=8000
OPENAI_API_KEY=""

# --- Model Integration Vector Vectors ---
MEM0_LLM_PROVIDER="ollama"          # Options: openai, ollama, anthropic, azure
MEM0_LLM_MODEL="llama3.1:8b"         # Options: gpt-4o-mini, llama3.1:8b
MEM0_EMBEDDER_PROVIDER="ollama"      # Options: openai, ollama
MEM0_EMBEDDER_MODEL="nomic-embed-text" # Options: text-embedding-3-small, nomic-embed-text
MEM0_LLM_TEMPERATURE=0.1
MEM0_LLM_MAX_TOKENS=2000

# ====================================================================================
# ⏱️ DURABLE ORCHESTRATION PIPELINES STRUCTURAL METRICS (Temporal Engine)
# ====================================================================================
TEMPORAL_PORT=7233
TEMPORAL_MEMBERSHIP_PORT=6933

# --- Internal Service Process Vectors ---
TEMPORAL_FRONTEND_PORT=7233
TEMPORAL_FRONTEND_MEMBERSHIP_PORT=6933
TEMPORAL_HISTORY_PORT=7234
TEMPORAL_HISTORY_MEMBERSHIP_PORT=6934
TEMPORAL_MATCHING_PORT=7235
TEMPORAL_MATCHING_MEMBERSHIP_PORT=6935
TEMPORAL_WORKER_PORT=7236
TEMPORAL_WORKER_MEMBERSHIP_PORT=6936

# ====================================================================================
# 📡 OFFLINE SIMULATION & WIREMOCK NETWORK ISOLATION BOUNDARIES
# ====================================================================================
MOCK_PROXY_URL="http://wiremock-harness:8080"
WIREMOCK_PORT=8080

# ====================================================================================
# 📊 CENTRAL TELEMETRY OPEN-TELEMETRY & FLIGHT TRACKING (OTel, Prometheus, Grafana)
# ====================================================================================
OTEL_TRACES_EXPORTER="otlp"
OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4317"

# --- Metrics Server & UI Parameters ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GF_AUTH_ANONYMOUS_ENABLED="true"
GF_AUTH_ANONYMOUS_ORG_ROLE="Admin"
