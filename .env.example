# Copy this file to .env and run Compose from the repository root:
# docker compose --project-directory . --env-file .env \
#   -f packages/deploy/compose/ci/compose.yml up -d

# ====================================================================
# Workbench source and images
# ====================================================================

# Resolved from --project-directory; use an absolute path in consumer repos.
PROJECT_DIR="."
REGISTRY="localhost:32443/ai-crew-suite"
IMAGE_TAG="latest"
# COSIGN_PRIVATE_KEY should be set in Github Repository
# Secrets, locally the cosign.key file is .gitignored
COSIGN_PASSWORD="your-secure-key-password-here"

# Docker Hub authentication (optional): forwarded by the image build/publish services
# as the daemon registry auth header so base-image pulls and GHCR pushes authenticate
# under your account's dedicated quota instead of shared anonymous per-IP limits.
# Preferred over ~/.docker/config.json when both are present. In CI these come from
# the workflow's docker/login-action step instead (DOCKER_HUB_* repository secrets).
DOCKER_HUB_USERNAME="your-docker-hub-username"
DOCKER_HUB_TOKEN="your-docker-hub-personal-access-token"

# Backend-only layout: the project directory is the plugin directory.
COMPOSE_PROFILES=""
BACKEND_PLUGIN_DIR="."
# Paired layout in the common root:
# COMPOSE_PROFILES="frontend"
# BACKEND_PLUGIN_DIR="backend"
FRONTEND_PLUGIN_DIR="frontend"

# Each plugin package supplies its own start script. Override only if needed.
# BACKEND_START_CMD="yarn start"
# FRONTEND_START_CMD="yarn start"

# ====================================================================
# Host-published HTTP ports (loopback only)
# ====================================================================

BACKEND_PORT=7007
FRONTEND_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
WIREMOCK_PORT=8080

# ====================================================================
# Backstage stack
# ====================================================================

BACKEND_HOST="localhost"
FRONTEND_HOST="localhost"

# PostgreSQL, Redis, Mem0, Temporal, Tempo, OpenTelemetry, and Redis
# exporter ports are private to the Compose network and need no host ports.

# ====================================================================
# PostgreSQL / pgvector
# ====================================================================

# Host, port, and internal service addresses are fixed by Compose.
POSTGRES_DB="postgres_workbench"
POSTGRES_USER="workbench"
POSTGRES_PASSWORD="postgres_secret_pass"

# ====================================================================
# Mem0
# ====================================================================

MEM0_PROVIDER_API_KEY=""
MEM0_LLM_PROVIDER="ollama"              # openai, ollama, anthropic, azure_openai
MEM0_LLM_MODEL="llama3.1:8b"            # e.g. gpt-4o-mini or llama3.1:8b
MEM0_LLM_TEMPERATURE=0.1
MEM0_LLM_MAX_TOKENS=2000
MEM0_EMBEDDER_PROVIDER="ollama"         # openai or ollama
MEM0_EMBEDDER_MODEL="nomic-embed-text"  # e.g. text-embedding-3-small or nomic-embed-text

# ====================================================================
# AWS / Terraform test runner (not used by the Compose services)
# ====================================================================

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
AWS_DEFAULT_REGION="us-east-1"
TF_VAR_database_secure_password=""
