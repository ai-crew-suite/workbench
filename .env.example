# ====================================================================
# Registry Info (Local Zot or GHCR)
# ====================================================================

REGISTRY="localhost:32443/ai-crew-suite"
IMAGE_TAG="latest"

# ====================================================================
#  Ports Configuration
# ====================================================================

BACKEND_PORT=7007
FRONTEND_PORT=3000
GRAFANA_PORT=3000
MEM0_PORT=8000
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
REDIS_HOST_PORT=6379
WIREMOCK_PORT=8080

# ====================================================================
#  Mem0 Engine
# ====================================================================

MEM0_PROVIDER_API_KEY=""
MEM0_LLM_PROVIDER="ollama"              # Options: openai, ollama, anthropic, azure
MEM0_LLM_MODEL="llama3.1:8b"            # Options: gpt-4o-mini, llama3.1:8b
MEM0_EMBEDDER_PROVIDER="ollama"         # Options: openai, ollama
MEM0_EMBEDDER_MODEL="nomic-embed-text"  # Options: text-embedding-3-small, nomic-embed-text
MEM0_LLM_TEMPERATURE=0.1
MEM0_LLM_MAX_TOKENS=2000


# ====================================================================
#  OTel, Prometheus, Grafana)
# ====================================================================

OTEL_TRACES_EXPORTER="otlp"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost"

# ====================================================================
#  Pgvector / PostgreSQL
# ====================================================================

POSTGRES_DB="postgres_workbench"
POSTGRES_HOST="postgres-store"
POSTGRES_PASSWORD="postgres_secret_pass"
POSTGRES_PORT=5432
POSTGRES_USER="workbench"

# ====================================================================
#  Prometheus
# ====================================================================

PROMETHEUS_PORT=9090

# ====================================================================
#  Redis
# ====================================================================

REDIS_ADDR="redis-cache:6379"
REDIS_HOST_PORT=6379
REDIS_URL="redis-cache"

# ====================================================================
#  Temporal Engine
# ====================================================================

TEMPORAL_PORT=7233
TEMPORAL_MEMBERSHIP_PORT=6933

# --- Internal Service Process Vectors ---
TEMPORAL_FRONTEND_PORT=7233
TEMPORAL_FRONTEND_MEMBERSHIP_PORT=6933
TEMPORAL_HISTORY_PORT=7234
TEMPORAL_HISTORY_MEMBERSHIP_PORT=6934
TEMPORAL_MATCHING_PORT=7235
TEMPORAL_MATCHING_MEMBERSHIP_PORT=6935
TEMPORAL_WORKER_PORT=7236
TEMPORAL_WORKER_MEMBERSHIP_PORT=6936

# ====================================================================
#  Wiremock
# ====================================================================

WIREMOCK_URL="http://localhost"
WIREMOCK_PORT=8080

# ====================================================================
#  AWS Test Runner Setup
# ====================================================================

TF_VAR_database_secure_password=""

# --- Cloud Ingress Targets ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
