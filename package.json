{
  "name": "@ai-crew-suite/workbench",
  "description": "Testing and dev server setup for AI Crew Suite",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "22 || 24",
    "npm": "Please use Yarn instead (Corepack enable)"
  },
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "helm:lint": "turbo run helm:lint",
    "helm:template": "turbo run helm:template",
    "image:build": "turbo run image:build --filter=@ai-crew-suite/dockerfiles",
    "infra:up": "turbo run compose:up --filter=@ai-crew-suite/dockerfiles",
    "infra:down": "turbo run compose:down --filter=@ai-crew-suite/dockerfiles",
    "infra:logs": "yarn workspace @ai-crew-suite/dockerfiles compose:logs",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "tf:init": "turbo run tf:init",
    "tf:plan": "turbo run tf:plan",
    "tf:validate": "turbo run tf:validate",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "catalog:dev",
    "@ai-crew-suite/typescript-shared-config": "catalog:dev",
    "@backstage/cli": "backstage:^",
    "@backstage/cli-defaults": "backstage:^",
    "@changesets/cli": "catalog:dev",
    "@types/react": "catalog:dev",
    "turbo": "catalog:dev"
  },
  "resolutions": {
    "got": "11.8.6"
  }
}
