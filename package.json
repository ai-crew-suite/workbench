{
  "name": "@ai-crew-suite/workbench",
  "description": "Testing and dev server setup for AI Crew Suite",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "22 || 24",
    "npm": "Please use Yarn instead (Corepack enable)"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "compile": "turbo run build",
    "helm:lint": "turbo run helm:lint --filter=@ai-crew-suite/deploy-kubernetes",
    "helm:template": "turbo run helm:template --filter=@ai-crew-suite/deploy-kubernetes",
    "image:build": "docker buildx build --builder=default --no-cache --load -t ai-crew-suite/backstage:latest -f packages/containers/backstage-node22.Dockerfile .",
    "infra:down": "turbo run compose:down --filter=@ai-crew-suite/containers",
    "infra:logs": "yarn workspace @ai-crew-suite/containers run compose:logs",
    "infra:up": "turbo run compose:up --filter=@ai-crew-suite/containers",
    "install:clean": "rm -rf node_modules .yarn/cache .yarn/unplugged yarn.lock",
    "lint": "turbo run lint",
    "start:legacy": "turbo run start --filter=@ai-crew-suite/backend-legacy",
    "start:modern": "turbo run start --filter=@ai-crew-suite/backend-modern",
    "tf:init": "turbo run tf:init --filter=@ai-crew-suite/deploy-terraform",
    "tf:plan": "turbo run tf:plan --filter=@ai-crew-suite/deploy-terraform",
    "tf:validate": "turbo run tf:validate --filter=@ai-crew-suite/deploy-terraform"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "catalog:dev",
    "@ai-crew-suite/typescript-shared-config": "catalog:dev",
    "turbo": "catalog:dev"
  },
  "resolutions": {
    "got": "11.8.6"
  }
}
